# --- Upstream: 3x-ui JSON subscription (sub-сервер, НЕ панель) ---
# Скопируйте JSON URL из карточки клиента и разбейте на BASE + PATH.
# Пример: https://example.com/<ваш-json-path>/<sub_id>
#   UPSTREAM_BASE_URL=https://example.com
#   UPSTREAM_JSON_PATH=/<ваш-json-path>
UPSTREAM_BASE_URL=https://upstream.example.com
UPSTREAM_JSON_PATH=/json
UPSTREAM_VERIFY_SSL=true
UPSTREAM_HOST_HEADER=

REQUEST_TIMEOUT_SEC=15

# --- Agent ---
AGENT_HOST=127.0.0.1
AGENT_PORT=8080
# Путь, на котором слушает агент (nginx proxy_pass). Пусто = как UPSTREAM_JSON_PATH.
AGENT_JSON_PATH=

# --- Transform: ios-fix | ios-fix-dns (плюс DNS через прокси) | passthrough ---
TRANSFORM_MODE=ios-fix

# --- БС-балансер: отдельная функция, работает с любым TRANSFORM_MODE ---
# Композиция только при однозначной паре балансеров с метками [A] и [B] в remarks.
ALLOWLIST_BALANCER_ENABLED=true
ALLOWLIST_BALANCER_NAME="Автовыбор — A → Б"
# Двухбуквенный код флага (RU/NL/DE), пусто — без флага.
ALLOWLIST_BALANCER_FLAG=
# auto — подпись первого узла A; либо свой текст под названием в Happ.
ALLOWLIST_BALANCER_DESCRIPTION=auto
ALLOWLIST_PROBE_URL=https://www.gstatic.com/generate_204
ALLOWLIST_PROBE_INTERVAL_SEC=20

DB_PATH=data/middleware.db
