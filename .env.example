# --- Upstream: 3x-ui JSON subscription ---
UPSTREAM_BASE_URL=https://panel.example.com
UPSTREAM_JSON_PATH=/json
UPSTREAM_VERIFY_SSL=true
UPSTREAM_HOST_HEADER=

REQUEST_TIMEOUT_SEC=15

# --- Agent ---
AGENT_HOST=127.0.0.1
AGENT_PORT=8080

# --- Transform: passthrough | rules ---
TRANSFORM_MODE=passthrough
RULES_PATH=config/rules.yaml
DB_PATH=data/middleware.db

# --- 3x-ui Panel API (inbound catalog + client groups) ---
PANEL_API_BASE_URL=
PANEL_WEB_BASE_PATH=
PANEL_API_TOKEN=
PANEL_VERIFY_SSL=